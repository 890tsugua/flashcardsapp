  "cards": [
    {
      "word": "σπίτι",
      "article": "το",
      "translation": "house, home",
      "transliteration": "spíti",
      "partOfSpeech": "noun",
      "gender": "neuter",
      "definition": "A building or place where someone lives.",
      "forms": { "plural": "τα σπίτια" },
      "examples": [{ "text": "Το σπίτι μου είναι κοντά στη θάλασσα.", "translation": "My house is near the sea." }],
      "notes": "Πάω σπίτι = I'm going home.",
      "tags": ["home"]
    },
    {
      "word": "άνθρωπος",
      "article": "ο",
      "translation": "person, human being",
      "transliteration": "ánthropos",
      "partOfSpeech": "noun",
      "gender": "masculine",
      "definition": "A man, woman or child; a member of the human race.",
      "forms": { "plural": "οι άνθρωποι" },
      "examples": [{ "text": "Είναι πολύ καλός άνθρωπος.", "translation": "He is a very good person." }],
      "notes": "The plural οι άνθρωποι is also the everyday word for \"people\".",
      "tags": ["people"]
    },
    {
      "word": "γυναίκα",
      "article": "η",
      "translation": "woman; wife",
      "transliteration": "yinéka",
      "partOfSpeech": "noun",
      "gender": "feminine",
      "definition": "An adult female person; also used for one's wife.",
      "forms": { "plural": "οι γυναίκες" },
      "examples": [{ "text": "Η γυναίκα μου είναι από την Αθήνα.", "translation": "My wife is from Athens." }],
      "tags": ["people"]
    },
    {
      "word": "άντρας",
      "article": "ο",
      "translation": "man; husband",
      "transliteration": "ándras",
      "partOfSpeech": "noun",
      "gender": "masculine",
      "definition": "An adult male person; also used for one's husband.",
      "forms": { "plural": "οι άντρες" },
      "examples": [{ "text": "Ο άντρας με το μαύρο καπέλο είναι ο θείος μου.", "translation": "The man in the black hat is my uncle." }],
      "notes": "Also spelled άνδρας (more formal).",
