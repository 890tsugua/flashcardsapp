      "article": "η",
      "translation": "day",
      "transliteration": "méra",
      "partOfSpeech": "noun",
      "gender": "feminine",
      "definition": "A period of 24 hours; also the time when it is light.",
      "forms": { "plural": "οι μέρες" },
      "examples": [{ "text": "Τι ωραία μέρα σήμερα!", "translation": "What a lovely day today!" }],
      "notes": "Formal form: η ημέρα.",
