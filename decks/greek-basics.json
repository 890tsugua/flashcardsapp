      "article": "το",
      "translation": "bread",
      "transliteration": "psomí",
      "partOfSpeech": "noun",
      "gender": "neuter",
      "definition": "A basic food made from flour and water and baked in an oven.",
      "forms": { "plural": "τα ψωμιά" },
      "examples": [{ "text": "Αγόρασα φρέσκο ψωμί.", "translation": "I bought fresh bread." }],
